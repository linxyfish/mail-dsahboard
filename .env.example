NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
# Optional API protection. Keep false for the local Web console.
AUTH_ENABLED=false
API_KEY=

# Required for live IMAP mode. Replace every value below.
IMAP_HOST=mail.your-domain.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=master@your-domain.com
IMAP_PASSWORD=your-imap-password
SMTP_HOST=mail.your-domain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=master@your-domain.com
SMTP_PASSWORD=your-smtp-password

# Telegram 设置现在优先在 Web「通知设置」中填写；以下仅作为首次启动默认值。
TG_BOT_TOKEN=
TG_CHAT_ID=
TEMPLATE_DIR=./apps/server/src/templates
TEMPLATE_DEFAULT=mail-default.hbs
POLL_CRON=*/1 * * * *
DATABASE_FILE=./data/store.json
DEMO_MODE=true
